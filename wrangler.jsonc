{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "inf125-live",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CLASSROOM",
        "class_name": "ClassroomSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ClassroomSession"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
